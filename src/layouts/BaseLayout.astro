---
import SeoHead from '@/components/SeoHead.astro';
import { getLocaleConfig, locales, type Locale } from '@/lib/i18n';
import { siteName } from '@/lib/seo';
import '@/styles/global.css';

interface AlternateLink {
  locale: Locale;
  path: string;
}

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
  image?: string;
  alternates?: AlternateLink[];
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  locale = 'es',
  canonicalPath = Astro.url.pathname,
  image,
  alternates = locales.map((item) => ({ locale: item, path: `/${item}/` })),
  jsonLd,
} = Astro.props;
const copy = getLocaleConfig(locale);
const site = Astro.site ?? new URL('https://web-elyara.example');
const otherLocale = locale === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      locale={locale}
      site={site}
      image={image}
      alternates={alternates}
      jsonLd={jsonLd}
    />
  </head>
  <body class="font-sans antialiased">
    <header class="sticky top-0 z-40 border-b border-white/60 bg-alhambra-sand/85 backdrop-blur-xl">
      <nav class="section-shell flex h-20 items-center justify-between gap-4" aria-label="Primary navigation">
        <a href={`/${locale}/`} class="font-serif text-2xl font-bold tracking-tight text-alhambra-night">
          {siteName}
        </a>
        <div class="hidden items-center gap-7 text-sm font-bold text-alhambra-night md:flex">
          <a class="hover:text-alhambra-clay" href={`/${locale}/#tours`}>{copy.navTours}</a>
          <a class="hover:text-alhambra-clay" href={`/${locale}/#experience`}>{copy.navAbout}</a>
          <a class="hover:text-alhambra-clay" href={`/${otherLocale}/`}>{getLocaleConfig(otherLocale).label}</a>
        </div>
        <a class="btn-primary px-4 py-2 text-xs" href="https://wa.me/34600000000" target="_blank" rel="noreferrer">
          {copy.reserve}
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-20 border-t border-alhambra-clay/10 bg-alhambra-night py-12 text-white">
      <div class="section-shell grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="eyebrow text-alhambra-sand">Granada walking routes</p>
          <p class="mt-3 max-w-xl text-3xl font-bold font-serif">{siteName}</p>
          <p class="mt-3 max-w-xl text-sm leading-7 text-white/75">{copy.heroText}</p>
        </div>
        <div class="flex gap-3 text-sm font-bold">
          <a href="/es/" class="hover:text-alhambra-sand">ES</a>
          <span class="text-white/30">/</span>
          <a href="/en/" class="hover:text-alhambra-sand">EN</a>
        </div>
      </div>
    </footer>
  </body>
</html>
