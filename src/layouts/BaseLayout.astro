---
import { Mail } from '@lucide/astro';
import SeoHead from '@/components/SeoHead.astro';
import { contactEmail, getContactContent, getContactPath, getEmailReservationUrl, getLocaleConfig, getTailorMadePath, instagramHandle, instagramUrl, locales, type Locale } from '@/lib/i18n';
import { siteName } from '@/lib/seo';
import '@/styles/global.css';

interface AlternateLink {
  locale: Locale;
  path: string;
}

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
  image?: string;
  alternates?: AlternateLink[];
  jsonLd?: Record<string, unknown>;
  ogType?: 'website' | 'article';
  hideReserveCta?: boolean;
}

const {
  title,
  description,
  locale = 'es',
  canonicalPath = Astro.url.pathname,
  image,
  alternates = locales.map((item) => ({ locale: item, path: `/${item}/` })),
  jsonLd,
  ogType = 'website',
  hideReserveCta = false,
} = Astro.props;
const copy = getLocaleConfig(locale);
const contact = getContactContent(locale);
const site = Astro.site ?? new URL('https://web-elyara.example');
const otherLocale = locale === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      locale={locale}
      site={site}
      image={image}
      alternates={alternates}
      jsonLd={jsonLd}
      ogType={ogType}
    />
  </head>
  <body class="font-sans antialiased">
    <header class="sticky top-0 z-40 border-b border-white/60 bg-alhambra-sand/85 backdrop-blur-xl">
      <nav class="section-shell flex min-h-20 flex-wrap items-center justify-between gap-3 py-3 sm:gap-4 sm:py-0" aria-label="Primary navigation">
        <a href={`/${locale}/`} class="flex min-w-0 items-center gap-2 font-serif text-base font-bold tracking-tight text-alhambra-night sm:gap-3 sm:text-2xl">
          <img src="/images/elyara-header-logo.png" alt="" class="h-10 w-10 shrink-0 object-contain sm:h-12 sm:w-12" aria-hidden="true" />
          <span class="whitespace-nowrap">{siteName}</span>
        </a>
        <div class="hidden items-center gap-5 text-sm font-bold text-alhambra-night lg:gap-7 md:flex">
          <a class="hover:text-alhambra-clay" href={`/${locale}/#tours`}>{copy.navTours}</a>
          <a class="hover:text-alhambra-clay" href={getTailorMadePath(locale)}>{copy.navTailorMade}</a>
          <a class="hover:text-alhambra-clay" href={`/${locale}/blog/`}>{copy.navBlog}</a>
          <a class="hover:text-alhambra-clay" href={`/${locale}/#experience`}>{copy.navAbout}</a>
          <a class="hover:text-alhambra-clay" href={getContactPath(locale)}>{copy.navContact}</a>
          <a class="hover:text-alhambra-clay" href={`/${otherLocale}/`}>{getLocaleConfig(otherLocale).label}</a>
        </div>
        {
          !hideReserveCta && (
            <a class="btn-primary px-4 py-2 text-xs" href={getEmailReservationUrl()}>
              {copy.reserve}
            </a>
          )
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-20 border-t border-alhambra-clay/10 bg-alhambra-night py-12 text-white">
      <div class="section-shell grid gap-8 md:grid-cols-2 md:items-end lg:grid-cols-[1fr_auto_auto]">
        <div>
          <p class="eyebrow text-alhambra-sand">Granada walking routes</p>
          <p class="mt-3 max-w-xl text-3xl font-bold font-serif">{siteName}</p>
          <p class="mt-3 max-w-xl text-sm leading-7 text-white/75">{copy.footerIntro}</p>
        </div>
        <div>
          <a href={getContactPath(locale)} class="text-sm font-bold text-alhambra-sand hover:text-white">{copy.footerContact}</a>
          <div class="mt-4 grid gap-3 text-sm font-bold text-white/80">
            <a href={`mailto:${contactEmail}`} class="inline-flex items-center gap-2 hover:text-alhambra-sand">
              <Mail class="h-4 w-4" aria-hidden="true" />
              {contactEmail}
            </a>
            <a href={instagramUrl} class="inline-flex items-center gap-2 hover:text-alhambra-sand" target="_blank" rel="noreferrer">
              <span class="text-xs font-black" aria-hidden="true">IG</span>
              {instagramHandle}
            </a>
            <a href={getContactPath(locale)} class="text-xs font-bold text-alhambra-sand hover:text-white">{contact.footerLink}</a>
          </div>
        </div>
        <div class="flex gap-3 text-sm font-bold">
          <a href={`/${locale}/blog/`} class="hover:text-alhambra-sand">{copy.navBlog}</a>
          <span class="text-white/30">/</span>
          <a href="/es/" class="hover:text-alhambra-sand">ES</a>
          <span class="text-white/30">/</span>
          <a href="/en/" class="hover:text-alhambra-sand">EN</a>
        </div>
      </div>
    </footer>
  </body>
</html>
