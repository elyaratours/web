---
import type { FaqEntry } from '@/lib/seo';

interface Props {
  title: string;
  entries: FaqEntry[];
}

const { title, entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="card p-5 sm:p-8" aria-labelledby="faq-title">
      <h2 id="faq-title" class="font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{title}</h2>
      <div class="mt-5 grid gap-3">
        {entries.map((item) => (
          <details class="rounded-2xl bg-alhambra-sand/60 p-4">
            <summary class="cursor-pointer font-bold text-alhambra-night">{item.question}</summary>
            <p class="mt-3 text-sm leading-7 text-slate-700">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
