---
import { ArrowRight, CircleCheck, Mail, MapPinned, MessageCircle } from '@lucide/astro';
import BlogCard from '@/components/BlogCard.astro';
import FaqSection from '@/components/FaqSection.astro';
import TourCard from '@/components/TourCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedBlogPosts } from '@/lib/blog';
import {
  getCommercialToursContent,
  getCommercialToursPath,
  getContactPath,
  getEmailReservationUrl,
  getLocaleConfig,
  getTailorMadePath,
  getWhatsAppReservationUrl,
  locales,
  type Locale,
} from '@/lib/i18n';
import { createBreadcrumbJsonLd, createFaqJsonLd, createItemListJsonLd, createTourServiceJsonLd, productionSiteUrl } from '@/lib/seo';
import { getPublishedTours, getTourPath } from '@/lib/tours';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getCommercialToursContent(locale);
const copy = getLocaleConfig(locale);
const site = Astro.site ?? new URL(productionSiteUrl);
const tours = await getPublishedTours(locale);
const posts = (await getPublishedBlogPosts(locale)).slice(0, 3);
const alternates = locales.map((item) => ({ locale: item, path: getCommercialToursPath(item) }));
const path = getCommercialToursPath(locale);
const faqJsonLd = createFaqJsonLd(content.faq);
const jsonLd = [
  createTourServiceJsonLd(locale, path, content.pageTitle, content.metaDescription, site),
  createBreadcrumbJsonLd(
    [
      { name: siteNameForLocale(locale), path: `/${locale}/` },
      { name: content.pageTitle, path },
    ],
    site,
  ),
  createItemListJsonLd(
    content.tourSectionTitle,
    tours.map((tour) => ({ name: tour.data.title, path: getTourPath(tour) })),
    site,
  ),
  faqJsonLd,
].filter((item) => item !== undefined);

function siteNameForLocale(currentLocale: Locale) {
  return currentLocale === 'es' ? 'Inicio' : 'Home';
}
---

<BaseLayout
  title={content.pageTitle}
  description={content.metaDescription}
  locale={locale}
  canonicalPath={path}
  image={content.image}
  imageAlt={content.imageAlt}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article class="section-shell py-8 sm:py-12 lg:py-20">
    <section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1 class="mt-4 max-w-4xl font-serif text-4xl font-bold leading-tight text-alhambra-night sm:text-5xl lg:text-6xl">{content.title}</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700 sm:text-lg sm:leading-8">{content.intro}</p>
        <div class="mt-7 grid gap-3 sm:flex sm:flex-wrap">
          <a class="btn-primary w-full sm:w-auto" href={getWhatsAppReservationUrl(locale)} target="_blank" rel="noreferrer">
            <MessageCircle class="h-4 w-4" aria-hidden="true" />
            {content.primaryCta}
          </a>
          <a class="btn-secondary w-full sm:w-auto" href={getEmailReservationUrl()}>
            <Mail class="h-4 w-4" aria-hidden="true" />
            {copy.reserveEmail}
          </a>
          <a class="btn-secondary w-full sm:w-auto" href="#tours">
            {content.secondaryCta}
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
      <div class="card overflow-hidden p-3 sm:p-4">
        <img src={content.image} alt={content.imageAlt} width="1200" height="800" decoding="async" fetchpriority="high" class="h-64 w-full rounded-[1.25rem] object-cover sm:h-[28rem] sm:rounded-[1.5rem]" />
      </div>
    </section>

    <section class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-3">
      {content.sections.map((section) => (
        <div class="card p-5 sm:p-7">
          <CircleCheck class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
          <h2 class="mt-5 font-serif text-2xl font-bold text-alhambra-night">{section.title}</h2>
          <p class="mt-4 text-sm leading-7 text-slate-700">{section.text}</p>
        </div>
      ))}
    </section>

    <section class="mt-10 sm:mt-12" id="tours">
      <div class="mb-8 max-w-3xl">
        <p class="eyebrow">{copy.allTours}</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{content.tourSectionTitle}</h2>
        <p class="mt-4 text-slate-700">{content.tourSectionText}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {tours.slice(0, 6).map((tour) => <TourCard tour={tour} />)}
      </div>
    </section>

    <section class="mt-10 grid gap-6 sm:mt-12 lg:grid-cols-2">
      <div class="card p-5 sm:p-7">
        <MapPinned class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
        <h2 class="mt-5 font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{content.tailorMadeTitle}</h2>
        <p class="mt-4 leading-8 text-slate-700">{content.tailorMadeText}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn-secondary" href={getTailorMadePath(locale)}>{copy.navTailorMade}</a>
          <a class="btn-secondary" href={getContactPath(locale)}>{copy.navContact}</a>
        </div>
      </div>
      <div class="card p-5 sm:p-7">
        <h2 class="font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{content.editorialTitle}</h2>
        <p class="mt-4 leading-8 text-slate-700">{content.editorialText}</p>
        <a class="mt-6 inline-flex font-bold text-alhambra-clay hover:text-alhambra-night" href={`/${locale}/blog/`}>{copy.navBlog}</a>
      </div>
    </section>

    {posts.length > 0 && (
      <section class="mt-10 sm:mt-12">
        <div class="mb-8 max-w-3xl">
          <p class="eyebrow">{copy.blogEyebrow}</p>
          <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{content.editorialTitle}</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => <BlogCard post={post} />)}
        </div>
      </section>
    )}

    <section class="mt-10 sm:mt-12">
      <FaqSection title={locale === 'es' ? 'Preguntas frecuentes' : 'Frequently asked questions'} entries={content.faq} />
    </section>
  </article>
</BaseLayout>
