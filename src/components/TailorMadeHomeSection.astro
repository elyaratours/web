---
import { ArrowRight, Compass, Mail, Sparkles } from '@lucide/astro';
import { getTailorMadeContent, getTailorMadeEmailUrl, getTailorMadePath, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getTailorMadeContent(locale);
const pagePath = getTailorMadePath(locale);
const emailUrl = getTailorMadeEmailUrl();
---

<section class="section-shell py-8 sm:py-12" id="tailor-made">
  <div class="card overflow-hidden bg-alhambra-night text-white">
    <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="relative min-h-64 overflow-hidden sm:min-h-72">
        <img src="/images/mapa.png" alt={content.imageAlt} class="h-full w-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-alhambra-night via-alhambra-night/30 to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 rounded-[1.25rem] bg-white/90 p-4 text-alhambra-night shadow-warm backdrop-blur sm:bottom-6 sm:left-6 sm:right-6 sm:rounded-[1.5rem] sm:p-5">
          <div class="flex items-start gap-3">
            <span class="rounded-2xl bg-alhambra-clay/10 p-3 text-alhambra-clay"><Sparkles class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <p class="text-[0.68rem] font-bold uppercase tracking-[0.2em] text-alhambra-clay sm:text-xs sm:tracking-[0.28em]">{content.eyebrow}</p>
              <p class="mt-2 text-sm leading-6 text-slate-700">{content.homeText}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="p-5 sm:p-10 lg:p-12">
        <p class="eyebrow text-alhambra-sand">{content.eyebrow}</p>
        <h2 class="mt-4 max-w-2xl font-serif text-3xl font-bold leading-tight sm:text-5xl">{content.title}</h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-white/80">{content.intro}</p>

        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <div class="rounded-[1.25rem] border border-white/10 bg-white/10 p-4 sm:rounded-[1.5rem] sm:p-5">
            <Compass class="h-6 w-6 text-alhambra-sand" aria-hidden="true" />
            <h3 class="mt-4 font-serif text-2xl font-bold">{content.consultationTitle}</h3>
            <p class="mt-3 text-sm leading-7 text-white/75">{content.consultationText}</p>
          </div>
          <div class="rounded-[1.25rem] border border-white/10 bg-white/10 p-4 sm:rounded-[1.5rem] sm:p-5">
            <Mail class="h-6 w-6 text-alhambra-sand" aria-hidden="true" />
            <h3 class="mt-4 font-serif text-2xl font-bold">{content.routeTitle}</h3>
            <p class="mt-3 text-sm leading-7 text-white/75">{content.routeText}</p>
          </div>
        </div>

        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
          <a class="btn-primary w-full bg-alhambra-sand text-alhambra-night hover:bg-white sm:w-auto" href={pagePath}>
            {content.cta}
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a class="btn-secondary w-full border-white/20 bg-white/10 text-white hover:bg-white hover:text-alhambra-night sm:w-auto" href={emailUrl}>
            <Mail class="h-4 w-4" aria-hidden="true" />
            Email
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
