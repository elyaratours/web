---
import { ArrowRight, Compass, MessageCircle, Sparkles } from '@lucide/astro';
import { getTailorMadeContent, getTailorMadePath, getTailorMadeWhatsAppUrl, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getTailorMadeContent(locale);
const pagePath = getTailorMadePath(locale);
const whatsappUrl = getTailorMadeWhatsAppUrl(locale);
---

<section class="section-shell py-12" id="tailor-made">
  <div class="card overflow-hidden bg-alhambra-night text-white">
    <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="relative min-h-72 overflow-hidden">
        <img src="/images/mapa.png" alt={content.imageAlt} class="h-full w-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-alhambra-night via-alhambra-night/30 to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 rounded-[1.5rem] bg-white/90 p-5 text-alhambra-night shadow-warm backdrop-blur">
          <div class="flex items-start gap-3">
            <span class="rounded-2xl bg-alhambra-clay/10 p-3 text-alhambra-clay"><Sparkles class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.28em] text-alhambra-clay">{content.eyebrow}</p>
              <p class="mt-2 text-sm leading-6 text-slate-700">{content.homeText}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="p-8 sm:p-10 lg:p-12">
        <p class="eyebrow text-alhambra-sand">{content.eyebrow}</p>
        <h2 class="mt-4 max-w-2xl font-serif text-4xl font-bold leading-tight sm:text-5xl">{content.title}</h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-white/80">{content.intro}</p>

        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <div class="rounded-[1.5rem] border border-white/10 bg-white/10 p-5">
            <Compass class="h-6 w-6 text-alhambra-sand" aria-hidden="true" />
            <h3 class="mt-4 font-serif text-2xl font-bold">{content.consultationTitle}</h3>
            <p class="mt-3 text-sm leading-7 text-white/75">{content.consultationText}</p>
          </div>
          <div class="rounded-[1.5rem] border border-white/10 bg-white/10 p-5">
            <MessageCircle class="h-6 w-6 text-alhambra-sand" aria-hidden="true" />
            <h3 class="mt-4 font-serif text-2xl font-bold">{content.routeTitle}</h3>
            <p class="mt-3 text-sm leading-7 text-white/75">{content.routeText}</p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary bg-alhambra-sand text-alhambra-night hover:bg-white" href={pagePath}>
            {content.cta}
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a class="btn-secondary border-white/20 bg-white/10 text-white hover:bg-white hover:text-alhambra-night" href={whatsappUrl} target="_blank" rel="noreferrer">
            <MessageCircle class="h-4 w-4" aria-hidden="true" />
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
