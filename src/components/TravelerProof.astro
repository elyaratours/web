---
import { ExternalLink, Quote, Sparkles } from '@lucide/astro';
import { googleBusinessProfileUrl, type Locale } from '@/lib/i18n';
import { getApprovedReviews } from '@/lib/reviews';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const reviews = getApprovedReviews(locale);
const featuredReview = reviews[0];
const supportingReviews = reviews.slice(1);
const copy = locale === 'es'
  ? {
      eyebrow: 'Viajeros reales',
      title: 'Opiniones de quienes ya caminaron Granada con Elyara',
      intro:
        'Comentarios publicados por viajeros reales en Google Business Profile, seleccionados solo cuando tienen texto aprobado para mostrarse.',
      source: 'Fuente: Google Business Profile',
      translated: 'Traduccion aprobada del comentario original',
      cta: 'Ver perfil publico en Google',
      profileLabel: 'Perfil publico',
    }
  : {
      eyebrow: 'Real travelers',
      title: 'Reviews from travelers who already walked Granada with Elyara',
      intro:
        'Comments published by real travelers on Google Business Profile, shown only when the review text is approved for publication.',
      source: 'Source: Google Business Profile',
      translated: 'Approved translation of the original review',
      cta: 'View public profile on Google',
      profileLabel: 'Public profile',
    };
---

{reviews.length > 0 && (
  <section class="section-shell py-10 sm:py-16" aria-labelledby="traveler-proof-title">
    <div class="relative overflow-hidden rounded-[2rem] bg-alhambra-night p-5 text-white shadow-warm sm:rounded-[2.5rem] sm:p-8 lg:p-10">
      <div class="absolute -left-20 top-8 h-52 w-52 rounded-full bg-alhambra-clay/35 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -right-24 bottom-0 h-64 w-64 rounded-full bg-alhambra-gold/25 blur-3xl" aria-hidden="true"></div>
      <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-alhambra-sand/70 to-transparent" aria-hidden="true"></div>

      <div class="relative">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="inline-flex items-center gap-2 rounded-full border border-alhambra-sand/25 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.24em] text-alhambra-sand">
              <Sparkles class="h-4 w-4" aria-hidden="true" />
              {copy.eyebrow}
            </p>
            <h2 id="traveler-proof-title" class="mt-5 font-serif text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">{copy.title}</h2>
            <p class="mt-5 max-w-2xl text-sm leading-7 text-white/75 sm:text-base sm:leading-8">{copy.intro}</p>
          </div>
          <a href={googleBusinessProfileUrl} class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-alhambra-sand/30 bg-alhambra-sand px-5 py-3 text-sm font-black text-alhambra-night transition hover:-translate-y-0.5 hover:bg-white sm:w-auto" target="_blank" rel="noreferrer">
            {copy.cta}
            <ExternalLink class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>

        <div class="mt-8 grid gap-5 lg:grid-cols-[0.9fr_1.35fr] lg:items-start">
          {featuredReview && (
            <figure class="relative overflow-hidden rounded-[2rem] border border-alhambra-sand/25 bg-white p-6 text-alhambra-night shadow-warm sm:p-8">
              <div class="absolute -right-6 -top-6 flex h-24 w-24 items-center justify-center rounded-full bg-alhambra-sand text-alhambra-clay" aria-hidden="true">
                <Quote class="h-10 w-10" />
              </div>
              <div class="relative">
                <p class="text-xs font-black uppercase tracking-[0.24em] text-alhambra-clay">{copy.profileLabel}</p>
                <blockquote class="mt-6 font-serif text-2xl font-bold leading-snug text-alhambra-night sm:text-3xl">“{featuredReview.text}”</blockquote>
                <figcaption class="mt-8 border-t border-alhambra-clay/15 pt-5 text-sm font-bold text-alhambra-night">
                  {featuredReview.attribution}
                  <span class="mt-1 block text-xs font-semibold uppercase tracking-[0.18em] text-alhambra-clay">{copy.source}</span>
                  {featuredReview.isApprovedTranslation && <span class="mt-2 block text-xs leading-5 text-slate-500">{copy.translated}</span>}
                </figcaption>
              </div>
            </figure>
          )}

          <div class="grid gap-4 md:grid-cols-2">
            {supportingReviews.map((review) => (
              <figure class="group rounded-[1.75rem] border border-white/15 bg-white/[0.08] p-5 shadow-[0_20px_70px_rgba(0,0,0,0.18)] backdrop-blur transition hover:-translate-y-1 hover:border-alhambra-sand/45 hover:bg-white/[0.12]">
                <Quote class="h-5 w-5 text-alhambra-sand/80" aria-hidden="true" />
                <blockquote class="mt-4 text-sm leading-7 text-white/85">“{review.text}”</blockquote>
                <figcaption class="mt-5 text-sm font-bold text-white">
                  {review.attribution}
                  <span class="mt-1 block text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-alhambra-sand/80">{copy.source}</span>
                  {review.isApprovedTranslation && <span class="mt-2 block text-xs leading-5 text-white/60">{copy.translated}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}
