---
import { googleBusinessProfileUrl, type Locale } from '@/lib/i18n';
import { getApprovedReviews } from '@/lib/reviews';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const reviews = getApprovedReviews(locale);
const copy = locale === 'es'
  ? {
      eyebrow: 'Viajeros reales',
      title: 'Opiniones publicadas por quienes ya caminaron Granada con Elyara',
      source: 'Fuente: Google Business Profile',
      translated: 'Traduccion aprobada del comentario original',
      cta: 'Ver perfil publico en Google',
    }
  : {
      eyebrow: 'Real travelers',
      title: 'Reviews published by travelers who already walked Granada with Elyara',
      source: 'Source: Google Business Profile',
      translated: 'Approved translation of the original review',
      cta: 'View public profile on Google',
    };
---

{reviews.length > 0 && (
  <section class="section-shell py-8 sm:py-12" aria-labelledby="traveler-proof-title">
    <div class="card p-5 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 id="traveler-proof-title" class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{copy.title}</h2>
      </div>
      <div class="mt-7 grid gap-4 md:grid-cols-3">
        {reviews.map((review) => (
          <figure class="rounded-3xl border border-alhambra-clay/15 bg-white/75 p-5">
            <blockquote class="text-sm leading-7 text-slate-700">“{review.text}”</blockquote>
            <figcaption class="mt-5 text-sm font-bold text-alhambra-night">
              {review.attribution}
              <span class="mt-1 block text-xs font-semibold uppercase tracking-[0.18em] text-alhambra-clay">{copy.source}</span>
              {review.isApprovedTranslation && <span class="mt-2 block text-xs leading-5 text-slate-500">{copy.translated}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
      <a href={googleBusinessProfileUrl} class="btn-secondary mt-7 w-full sm:w-auto" target="_blank" rel="noreferrer">{copy.cta}</a>
    </div>
  </section>
)}
