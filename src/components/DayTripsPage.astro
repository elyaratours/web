---
import { ArrowRight, CircleCheck, Mail, MapPinned, MessageCircle, Sparkles } from '@lucide/astro';
import FaqSection from '@/components/FaqSection.astro';
import TourCard from '@/components/TourCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getDayTripWhatsAppUrl,
  getDayTripsContent,
  getDayTripsPath,
  getEmailReservationUrl,
  locales,
  type Locale,
} from '@/lib/i18n';
import { createBreadcrumbJsonLd, createFaqJsonLd, createItemListJsonLd, createTourServiceJsonLd, productionSiteUrl } from '@/lib/seo';
import { getPublishedDayTrips, getTourPath } from '@/lib/tours';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getDayTripsContent(locale);
const path = getDayTripsPath(locale);
const dayTrips = await getPublishedDayTrips(locale);
const site = Astro.site ?? new URL(productionSiteUrl);
const alternates = locales.map((item) => ({ locale: item, path: getDayTripsPath(item) }));
const jsonLd = [
  createTourServiceJsonLd(locale, path, content.pageTitle, content.metaDescription, site),
  createBreadcrumbJsonLd(
    [
      { name: locale === 'es' ? 'Inicio' : 'Home', path: `/${locale}/` },
      { name: content.pageTitle, path },
    ],
    site,
  ),
  createItemListJsonLd(
    content.originsTitle,
    dayTrips.map((tour) => ({ name: tour.data.title, path: getTourPath(tour) })),
    site,
  ),
  createFaqJsonLd(content.faq),
].filter((item) => item !== undefined);
const whatsappUrl = getDayTripWhatsAppUrl(locale, content.pageTitle);
---

<BaseLayout
  title={content.pageTitle}
  description={content.metaDescription}
  locale={locale}
  canonicalPath={path}
  image={content.image}
  imageAlt={content.imageAlt}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article class="section-shell py-8 sm:py-12 lg:py-20">
    <section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1 class="mt-4 max-w-4xl font-serif text-4xl font-bold leading-tight text-alhambra-night sm:text-5xl lg:text-6xl">{content.title}</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700 sm:text-lg sm:leading-8">{content.intro}</p>
        <div class="mt-7 grid gap-3 sm:flex sm:flex-wrap">
          <a class="btn-primary w-full sm:w-auto" href={whatsappUrl} target="_blank" rel="noreferrer">
            <MessageCircle class="h-4 w-4" aria-hidden="true" />
            {content.primaryCta}
          </a>
          <a class="btn-secondary w-full sm:w-auto" href={getEmailReservationUrl()}>
            <Mail class="h-4 w-4" aria-hidden="true" />
            {content.emailCta}
          </a>
          <a class="btn-secondary w-full sm:w-auto" href="#origins">
            {content.secondaryCta}
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
      <div class="card overflow-hidden p-3 sm:p-4">
        <img src={content.image} alt={content.imageAlt} width="1200" height="800" decoding="async" fetchpriority="high" class="h-64 w-full rounded-[1.25rem] object-cover sm:h-[28rem] sm:rounded-[1.5rem]" />
      </div>
    </section>

    <section class="mt-10 sm:mt-12" id="origins">
      <div class="mb-8 max-w-3xl">
        <p class="eyebrow">{content.secondaryCta}</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{content.originsTitle}</h2>
        <p class="mt-4 leading-8 text-slate-700">{content.originsText}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {dayTrips.map((tour) => <TourCard tour={tour} showReservationCta />)}
      </div>
    </section>

    <section class="mt-10 sm:mt-12">
      <div class="mb-8 max-w-3xl">
        <p class="eyebrow">Granada</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{content.chooseTitle}</h2>
        <p class="mt-4 leading-8 text-slate-700">{content.chooseText}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {content.experienceOptions.map((option) => (
          <div class="card p-5 sm:p-7">
            <MapPinned class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
            <h3 class="mt-5 font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{option.title}</h3>
            <p class="mt-4 leading-8 text-slate-700">{option.text}</p>
            <ul class="mt-5 grid gap-3">
              {option.details.map((detail) => (
                <li class="flex items-center gap-3 text-sm font-bold text-slate-700">
                  <CircleCheck class="h-5 w-5 shrink-0 text-alhambra-clay" aria-hidden="true" />
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10 grid gap-6 sm:mt-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="card p-5 sm:p-7">
        <Sparkles class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
        <h2 class="mt-5 font-serif text-3xl font-bold text-alhambra-night">{content.completeTitle}</h2>
        <p class="mt-4 leading-8 text-slate-700">{content.completeText}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {content.complements.map((complement) => (
          <div class="card p-5">
            <CircleCheck class="h-7 w-7 text-alhambra-clay" aria-hidden="true" />
            <h3 class="mt-4 font-serif text-xl font-bold text-alhambra-night">{complement.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-700">{complement.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10 card grid gap-6 p-5 sm:mt-12 sm:gap-8 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="eyebrow">{content.requestTitle}</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night">{content.primaryCta}</h2>
        <p class="mt-4 max-w-3xl leading-8 text-slate-700">{content.requestText}</p>
      </div>
      <div class="grid gap-3 sm:flex sm:flex-wrap sm:justify-end">
        <a class="btn-primary w-full sm:w-auto" href={whatsappUrl} target="_blank" rel="noreferrer">
          <MessageCircle class="h-4 w-4" aria-hidden="true" />
          {content.primaryCta}
        </a>
        <a class="btn-secondary w-full sm:w-auto" href={getEmailReservationUrl()}>
          <Mail class="h-4 w-4" aria-hidden="true" />
          {content.emailCta}
        </a>
      </div>
    </section>

    <section class="mt-10 sm:mt-12">
      <FaqSection title={locale === 'es' ? 'Preguntas frecuentes' : 'Frequently asked questions'} entries={content.faq} />
    </section>
  </article>
</BaseLayout>
