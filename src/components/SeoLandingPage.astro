---
import { ArrowRight, BookOpen, CircleCheck, Mail, MessageCircle } from '@lucide/astro';
import { render } from 'astro:content';
import BlogCard from '@/components/BlogCard.astro';
import FaqSection from '@/components/FaqSection.astro';
import TourCard from '@/components/TourCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contactEmail, getContactPath, getEmailReservationUrl, getLocaleConfig, getTailorMadePath, getWhatsAppReservationUrl, whatsappDisplayNumber } from '@/lib/i18n';
import { createBreadcrumbJsonLd, createFaqJsonLd, createItemListJsonLd, createSeoLandingServiceJsonLd, productionSiteUrl } from '@/lib/seo';
import {
  getRelatedPostsForSeoLanding,
  getRelatedSeoLandingsForSeoLanding,
  getRelatedToursForSeoLanding,
  getSeoLandingAlternates,
  getSeoLandingPath,
  type SeoLandingEntry,
} from '@/lib/seo-landings';
import { getTourPath } from '@/lib/tours';

interface Props {
  landing: SeoLandingEntry;
}

const { landing } = Astro.props;
const locale = landing.data.locale;
const copy = getLocaleConfig(locale);
const { Content } = await render(landing);
const path = getSeoLandingPath(landing);
const site = Astro.site ?? new URL(productionSiteUrl);
const alternates = await getSeoLandingAlternates(landing);
const relatedTours = await getRelatedToursForSeoLanding(landing);
const relatedPosts = await getRelatedPostsForSeoLanding(landing);
const relatedLandings = await getRelatedSeoLandingsForSeoLanding(landing);
const labels =
  locale === 'es'
    ? {
        eyebrow: 'Guia local de Granada',
        usefulFor: 'Ideal si buscas',
        reserveTitle: 'Organiza tu visita',
        reserveText: 'Cuéntanos fechas, número de personas, idioma e intereses. Te responderemos por el canal que prefieras.',
        relatedTours: 'Rutas relacionadas',
        relatedArticles: 'Lecturas útiles',
        relatedLandings: 'También puede interesarte',
        contact: 'Contacto directo',
        tailorMade: 'Ruta a medida',
        faq: 'Preguntas frecuentes',
      }
    : {
        eyebrow: 'Local Granada guide',
        usefulFor: 'Useful if you are looking for',
        reserveTitle: 'Plan your visit',
        reserveText: 'Tell us your dates, group size, preferred language and interests. We will reply through your preferred channel.',
        relatedTours: 'Related tours',
        relatedArticles: 'Useful reading',
        relatedLandings: 'You may also like',
        contact: 'Direct contact',
        tailorMade: 'Tailor-made route',
        faq: 'Frequently asked questions',
      };
const faqJsonLd = createFaqJsonLd(landing.data.faq);
const jsonLd = [
  createSeoLandingServiceJsonLd(locale, path, landing.data.title, landing.data.seoDescription, landing.data.targetIntent, landing.data.image, site),
  createBreadcrumbJsonLd(
    [
      { name: locale === 'es' ? 'Inicio' : 'Home', path: `/${locale}/` },
      { name: landing.data.title, path },
    ],
    site,
  ),
  relatedTours.length > 0 && createItemListJsonLd(
    labels.relatedTours,
    relatedTours.map((tour) => ({ name: tour.data.title, path: getTourPath(tour) })),
    site,
  ),
  faqJsonLd,
].filter((item) => item !== undefined && item !== false);
---

<BaseLayout title={landing.data.title} description={landing.data.seoDescription} locale={locale} canonicalPath={path} image={landing.data.image} imageAlt={landing.data.imageAlt} alternates={alternates} jsonLd={jsonLd}>
  <article class="section-shell py-8 sm:py-12 lg:py-20">
    <section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1 class="mt-4 max-w-4xl font-serif text-4xl font-bold leading-tight text-alhambra-night sm:text-5xl lg:text-6xl">{landing.data.heading}</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700 sm:text-lg sm:leading-8">{landing.data.intro}</p>
        <div class="mt-7 grid gap-3 sm:flex sm:flex-wrap">
          <a class="btn-primary w-full sm:w-auto" href={getWhatsAppReservationUrl(locale)} target="_blank" rel="noreferrer">
            <MessageCircle class="h-4 w-4" aria-hidden="true" />
            {copy.reserveWhatsapp}
          </a>
          <a class="btn-secondary w-full sm:w-auto" href={getEmailReservationUrl()}>
            <Mail class="h-4 w-4" aria-hidden="true" />
            {copy.reserveEmail}
          </a>
          <a class="btn-secondary w-full sm:w-auto" href={getContactPath(locale)}>{labels.contact}</a>
        </div>
      </div>
      <div class="card overflow-hidden p-3 sm:p-4">
        <img src={landing.data.image} alt={landing.data.imageAlt} width="1200" height="800" decoding="async" fetchpriority="high" class="h-64 w-full rounded-[1.25rem] object-cover sm:h-[28rem] sm:rounded-[1.5rem]" />
      </div>
    </section>

    <section class="mt-10 grid gap-6 sm:mt-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
      <div class="order-2 grid gap-6 lg:order-none">
        <div class="card p-5 sm:p-8">
          <p class="eyebrow">{labels.usefulFor}</p>
          <p class="mt-3 font-serif text-2xl font-bold text-alhambra-night">{landing.data.targetIntent}</p>
          <div class="prose prose-slate mt-6 max-w-none prose-headings:font-serif prose-headings:text-alhambra-night prose-a:text-alhambra-clay">
            <Content />
          </div>
        </div>

        {relatedTours.length > 0 && (
          <section>
            <div class="mb-6 max-w-3xl">
              <p class="eyebrow">{copy.allTours}</p>
              <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{labels.relatedTours}</h2>
            </div>
            <div class="grid gap-6 md:grid-cols-2">
              {relatedTours.map((tour) => <TourCard tour={tour} showReservationCta />)}
            </div>
          </section>
        )}

        {relatedPosts.length > 0 && (
          <section>
            <div class="mb-6 max-w-3xl">
              <p class="eyebrow">{copy.blogEyebrow}</p>
              <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{labels.relatedArticles}</h2>
            </div>
            <div class="grid gap-6 md:grid-cols-2">
              {relatedPosts.map((post) => <BlogCard post={post} />)}
            </div>
          </section>
        )}

        <FaqSection title={labels.faq} entries={landing.data.faq} />
      </div>

      <aside class="card order-1 p-5 sm:p-6 lg:sticky lg:top-28 lg:order-none">
        <p class="eyebrow">{copy.reserve}</p>
        <h2 class="mt-3 font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{labels.reserveTitle}</h2>
        <p class="mt-4 text-sm leading-7 text-slate-700">{labels.reserveText}</p>
        <a class="btn-primary mt-6 w-full" href={getWhatsAppReservationUrl(locale)} target="_blank" rel="noreferrer">
          <MessageCircle class="h-4 w-4" aria-hidden="true" />
          {copy.reserveWhatsapp}
        </a>
        <a class="btn-secondary mt-3 w-full" href={getEmailReservationUrl()}>
          <Mail class="h-4 w-4" aria-hidden="true" />
          {copy.reserveEmail}
        </a>
        <div class="mt-3 grid gap-1 text-center text-sm font-bold text-alhambra-clay">
          <p class="select-all">{whatsappDisplayNumber}</p>
          <p class="select-all">{contactEmail}</p>
        </div>
        <div class="mt-6 grid gap-2 border-t border-alhambra-clay/10 pt-5 text-sm font-bold">
          <a class="inline-flex items-center gap-2 text-alhambra-clay hover:text-alhambra-night" href={getTailorMadePath(locale)}>
            {labels.tailorMade}
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a class="inline-flex items-center gap-2 text-alhambra-clay hover:text-alhambra-night" href={getContactPath(locale)}>
            {copy.navContact}
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </aside>
    </section>

    {relatedLandings.length > 0 && (
      <section class="mt-10 card p-5 sm:mt-12 sm:p-8">
        <div class="mb-6 flex items-start gap-3">
          <BookOpen class="h-6 w-6 text-alhambra-clay" aria-hidden="true" />
          <div>
            <p class="eyebrow">{labels.relatedLandings}</p>
            <h2 class="mt-2 font-serif text-3xl font-bold text-alhambra-night">{copy.navTours}</h2>
          </div>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedLandings.map((item) => (
            <a class="flex items-center gap-3 rounded-2xl bg-alhambra-sand/60 p-4 text-sm font-bold text-alhambra-night transition hover:-translate-y-0.5 hover:text-alhambra-clay" href={getSeoLandingPath(item)}>
              <CircleCheck class="h-5 w-5 shrink-0 text-alhambra-clay" aria-hidden="true" />
              <span>{item.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
