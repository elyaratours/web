---
import { ArrowRight, Clock, Languages, MessageCircle, Ticket } from '@lucide/astro';
import { getDayTripsContent, getDayTripWhatsAppUrl, getLocaleConfig, getPrivateTourWhatsAppReservationUrl } from '@/lib/i18n';
import { getTourPath, type TourEntry } from '@/lib/tours';

interface Props {
  tour: TourEntry;
  showReservationCta?: boolean;
}

const { tour, showReservationCta = false } = Astro.props;
const copy = getLocaleConfig(tour.data.locale);
const href = getTourPath(tour);
const isDayTrip = tour.data.category === 'day-trip';
const dayTripCopy = getDayTripsContent(tour.data.locale);
const whatsappReservationUrl = isDayTrip
  ? getDayTripWhatsAppUrl(tour.data.locale, tour.data.title)
  : getPrivateTourWhatsAppReservationUrl(tour.data.locale, tour.data.title);
const reservationLabel = isDayTrip ? dayTripCopy.primaryCta : copy.reservePrivateGroup;
---

<article class="card group overflow-hidden">
  <a href={href} class="block" aria-label={`${copy.viewTour}: ${tour.data.title}`}>
    <div class="relative aspect-[4/3] overflow-hidden bg-alhambra-tile/10">
      <img
        src={tour.data.image}
        alt={tour.data.imageAlt}
        width="800"
        height="600"
        decoding="async"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-alhambra-clay sm:left-4 sm:top-4">
        {tour.data.price}
      </div>
    </div>
  </a>
  <div class="space-y-4 p-5 sm:space-y-5 sm:p-6">
    <div>
      <p class="eyebrow">{copy.viewTour}</p>
      <h2 class="mt-2 font-serif text-2xl font-bold leading-tight text-alhambra-night sm:text-3xl">
        <a href={href} class="hover:text-alhambra-clay">{tour.data.title}</a>
      </h2>
      <p class="mt-3 text-sm leading-7 text-slate-700">{tour.data.seoDescription}</p>
      {!isDayTrip && <p class="mt-3 text-sm font-bold text-alhambra-clay">{copy.privateGroupText}</p>}
    </div>
    <dl class="grid gap-3 text-sm text-slate-700">
      <div class="flex items-center gap-3">
        <Clock class="h-4 w-4 text-alhambra-clay" aria-hidden="true" />
        <dt class="sr-only">{copy.duration}</dt>
        <dd>{tour.data.duration}</dd>
      </div>
      <div class="flex items-center gap-3">
        <Languages class="h-4 w-4 text-alhambra-clay" aria-hidden="true" />
        <dt class="sr-only">{copy.languages}</dt>
        <dd>{tour.data.languages.join(' · ')}</dd>
      </div>
      <div class="flex items-center gap-3">
        <Ticket class="h-4 w-4 text-alhambra-clay" aria-hidden="true" />
        <dt class="sr-only">{copy.price}</dt>
        <dd>{tour.data.price}</dd>
      </div>
    </dl>
    <div class="grid gap-3 sm:flex sm:flex-wrap">
      <a href={href} class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-alhambra-clay/30 px-5 py-3 text-center text-sm font-bold text-alhambra-clay transition hover:border-alhambra-night hover:text-alhambra-night focus:outline-none focus:ring-2 focus:ring-alhambra-clay focus:ring-offset-2">
        {copy.viewTour}
        <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" aria-hidden="true" />
      </a>
      {
        showReservationCta && (
          <a class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-alhambra-wine px-5 py-3 text-center text-sm font-bold text-white shadow-warm transition hover:-translate-y-0.5 hover:bg-alhambra-night focus:outline-none focus:ring-2 focus:ring-alhambra-wine focus:ring-offset-2" href={whatsappReservationUrl} target="_blank" rel="noreferrer">
            <MessageCircle class="h-4 w-4" aria-hidden="true" />
            {reservationLabel}
          </a>
        )
      }
    </div>
  </div>
</article>
