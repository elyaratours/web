---
import { ArrowRight, CircleCheck, Mail, MessageCircle } from '@lucide/astro';
import BlogCard from '@/components/BlogCard.astro';
import TourCard from '@/components/TourCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getAuthorityAlternates,
  getAuthorityContent,
  getAuthorityDiscoveryLinks,
  getAuthorityJsonLd,
  getAuthorityPath,
  getAuthorityPosts,
  getAuthorityTours,
  getEmailReservationUrl,
  getWhatsAppReservationUrl,
  type Locale,
} from '@/lib/authority';
import { getLocaleConfig } from '@/lib/i18n';
import { createBreadcrumbJsonLd, productionSiteUrl } from '@/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getLocaleConfig(locale);
const content = getAuthorityContent(locale);
const path = getAuthorityPath(locale);
const site = Astro.site ?? new URL(productionSiteUrl);
const tours = await getAuthorityTours(locale);
const posts = await getAuthorityPosts(locale);
const discoveryLinks = getAuthorityDiscoveryLinks(locale);
const jsonLd = [
  getAuthorityJsonLd(locale, site),
  createBreadcrumbJsonLd(
    [
      { name: locale === 'es' ? 'Inicio' : 'Home', path: `/${locale}/` },
      { name: content.title, path },
    ],
    site,
  ),
];
---

<BaseLayout title={content.title} description={content.metaDescription} locale={locale} canonicalPath={path} image="/images/Granada-main.jpeg" imageAlt={content.imageAlt} alternates={getAuthorityAlternates()} jsonLd={jsonLd}>
  <article class="section-shell py-8 sm:py-12 lg:py-20">
    <section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1 class="mt-4 max-w-4xl font-serif text-4xl font-bold leading-tight text-alhambra-night sm:text-5xl lg:text-6xl">{content.heading}</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700 sm:mt-6 sm:text-lg sm:leading-8">{content.intro}</p>
        <div class="mt-7 grid gap-3 sm:mt-8 sm:flex sm:flex-wrap">
          <a class="btn-primary w-full sm:w-auto" href={getWhatsAppReservationUrl(locale)} target="_blank" rel="noreferrer">
            <MessageCircle class="h-4 w-4" aria-hidden="true" />
            {content.whatsappCta}
          </a>
          <a class="btn-secondary w-full sm:w-auto" href={getEmailReservationUrl()}>
            <Mail class="h-4 w-4" aria-hidden="true" />
            {content.emailCta}
          </a>
        </div>
      </div>
      <div class="card overflow-hidden p-3 sm:p-4">
        <img src="/images/Granada-main.jpeg" alt={content.imageAlt} width="1200" height="800" decoding="async" fetchpriority="high" class="h-64 w-full rounded-[1.25rem] object-cover sm:h-[28rem] sm:rounded-[1.5rem]" />
      </div>
    </section>

    <section class="mt-10 grid gap-6 sm:mt-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
      <div class="grid gap-6">
        <div class="card p-5 sm:p-8">
          <h2 class="font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{content.approachTitle}</h2>
          <p class="mt-4 leading-8 text-slate-700">{content.approachText}</p>
        </div>

        {tours.length > 0 && (
          <section>
            <div class="mb-6 max-w-3xl">
              <p class="eyebrow">{copy.navTours}</p>
              <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{copy.featuredTours}</h2>
            </div>
            <div class="grid gap-6 md:grid-cols-2">
              {tours.map((tour) => <TourCard tour={tour} showReservationCta />)}
            </div>
          </section>
        )}

        {posts.length > 0 && (
          <section>
            <div class="mb-6 max-w-3xl">
              <p class="eyebrow">{copy.blogEyebrow}</p>
              <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{content.linksTitle}</h2>
            </div>
            <div class="grid gap-6 md:grid-cols-2">
              {posts.map((post) => <BlogCard post={post} />)}
            </div>
          </section>
        )}
      </div>

      <aside class="card p-5 sm:p-6 lg:sticky lg:top-28">
        <p class="eyebrow">{content.factsTitle}</p>
        <ul class="mt-5 grid gap-3">
          {content.facts.map((item) => (
            <li class="flex gap-3 text-sm leading-6 text-slate-700">
              <CircleCheck class="mt-0.5 h-4 w-4 shrink-0 text-alhambra-clay" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6 border-t border-alhambra-clay/10 pt-5">
          <h2 class="font-serif text-2xl font-bold text-alhambra-night">{content.ctaTitle}</h2>
          <p class="mt-3 text-sm leading-7 text-slate-700">{content.ctaText}</p>
          <a class="btn-primary mt-5 w-full" href={getWhatsAppReservationUrl(locale)} target="_blank" rel="noreferrer">{content.whatsappCta}</a>
          <a class="btn-secondary mt-3 w-full" href={getEmailReservationUrl()}>{content.emailCta}</a>
        </div>
        <div class="mt-6 grid gap-2 border-t border-alhambra-clay/10 pt-5 text-sm font-bold">
          {discoveryLinks.map((item) => (
            <a class="inline-flex items-center justify-between gap-3 rounded-2xl bg-alhambra-sand/60 px-4 py-3 text-alhambra-night hover:text-alhambra-clay" href={item.path}>
              <span>{item.label}</span>
              <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </a>
          ))}
        </div>
      </aside>
    </section>
  </article>
</BaseLayout>
