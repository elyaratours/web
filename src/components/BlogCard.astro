---
import { ArrowRight, CalendarDays } from '@lucide/astro';
import { getBlogPostPath, type BlogEntry } from '@/lib/blog';
import { getBlogCategoryLabel, getLocaleConfig } from '@/lib/i18n';

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const copy = getLocaleConfig(post.data.locale);
const href = getBlogPostPath(post);
const date = new Intl.DateTimeFormat(copy.htmlLang, { dateStyle: 'medium' }).format(post.data.publishedDate);
const imageStyle = post.data.imagePosition ? `object-position: ${post.data.imagePosition};` : undefined;
---

<article class="card group overflow-hidden">
  <a href={href} class="block" aria-label={`${copy.readArticle}: ${post.data.title}`}>
    {post.data.image && (
      <div class="relative aspect-[4/3] overflow-hidden bg-alhambra-clay/10">
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
          style={imageStyle}
          loading="lazy"
        />
        <div class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-alhambra-clay sm:left-4 sm:top-4">
          {getBlogCategoryLabel(post.data.locale, post.data.category)}
        </div>
      </div>
    )}
    <div class="space-y-4 p-5 sm:space-y-5 sm:p-6">
      <div>
        {!post.data.image && <p class="eyebrow">{getBlogCategoryLabel(post.data.locale, post.data.category)}</p>}
        <h2 class="mt-2 font-serif text-2xl font-bold leading-tight text-alhambra-night sm:text-3xl">{post.data.title}</h2>
        <p class="mt-3 text-sm leading-7 text-slate-700">{post.data.excerpt}</p>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-slate-700">
        <span class="inline-flex items-center gap-2">
          <CalendarDays class="h-4 w-4 text-alhambra-clay" aria-hidden="true" />
          {date}
        </span>
        <span class="inline-flex items-center gap-2 font-bold text-alhambra-clay">
          {copy.readArticle}
          <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" aria-hidden="true" />
        </span>
      </div>
    </div>
  </a>
</article>
