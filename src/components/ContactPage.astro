---
import { ArrowLeft, CircleCheck, Mail } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  contactEmail,
  getContactContent,
  getContactPath,
  instagramHandle,
  instagramUrl,
  locales,
  type Locale,
} from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContactContent(locale);
const alternates = locales.map((item) => ({ locale: item, path: getContactPath(item) }));
const contactImage = '/images/Contacto.png';
---

<BaseLayout
  title={content.title}
  description={content.metaDescription}
  locale={locale}
  canonicalPath={getContactPath(locale)}
  image={contactImage}
  alternates={alternates}
  hideReserveCta
>
  <article class="section-shell py-12 lg:py-20">
    <a href={`/${locale}/`} class="inline-flex items-center gap-2 text-sm font-bold text-alhambra-clay hover:text-alhambra-night">
      <ArrowLeft class="h-4 w-4" aria-hidden="true" />
      Elyara Tours Granada
    </a>

    <section class="mt-8 grid gap-10 lg:grid-cols-[1fr_0.95fr] lg:items-center">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1 class="mt-4 max-w-4xl font-serif text-5xl font-bold leading-tight text-alhambra-night sm:text-6xl">{content.heading}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700">{content.intro}</p>
      </div>
      <div class="card overflow-hidden p-4">
        <img src={contactImage} alt={content.imageAlt} class="h-[24rem] w-full rounded-[1.5rem] object-cover" />
      </div>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-2">
      <a href={`mailto:${contactEmail}`} class="card group block p-7 transition hover:-translate-y-1 hover:border-alhambra-clay/30">
        <Mail class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
        <p class="mt-5 text-sm font-bold uppercase tracking-[0.28em] text-alhambra-clay">{content.emailLabel}</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night">{contactEmail}</h2>
        <p class="mt-5 text-sm font-bold text-alhambra-clay">{content.emailCta}</p>
      </a>

      <a href={instagramUrl} class="card group block p-7 transition hover:-translate-y-1 hover:border-alhambra-clay/30" target="_blank" rel="noreferrer">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-alhambra-clay text-xs font-black text-white" aria-hidden="true">IG</span>
        <p class="mt-5 text-sm font-bold uppercase tracking-[0.28em] text-alhambra-clay">{content.instagramLabel}</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night">{instagramHandle}</h2>
        <p class="mt-5 text-sm font-bold text-alhambra-clay">{content.instagramCta}</p>
      </a>
    </section>

    <section class="mt-12 card p-8">
      <h2 class="font-serif text-3xl font-bold text-alhambra-night">{content.reasonsTitle}</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          content.reasons.map((reason) => (
            <div class="flex items-center gap-3 rounded-2xl bg-alhambra-sand/60 p-4 text-sm font-bold text-alhambra-night">
              <CircleCheck class="h-5 w-5 shrink-0 text-alhambra-clay" aria-hidden="true" />
              <span>{reason}</span>
            </div>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
