---
import { Camera, Quote, X } from '@lucide/astro';
import type { Locale } from '@/lib/i18n';
import { reviewMosaicCopy, reviewMosaicItems } from '@/lib/reviews';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = reviewMosaicCopy[locale];
const dialogId = `traveler-reviews-dialog-${locale}`;
const dialogTitleId = `${dialogId}-title`;

const popupItems = reviewMosaicItems.map((item) => {
  if (item.type === 'photo') {
    return {
      id: item.id,
      type: item.type,
      image: item.image,
      alt: item.alt[locale],
      caption: item.caption[locale],
    };
  }

  return {
    id: item.id,
    type: item.type,
    excerpt: item.excerpt[locale],
    text: item.text[locale],
    traveler: item.traveler,
    origin: item.origin[locale],
    route: item.route[locale],
  };
});
---

<section class="section-shell py-8 sm:py-12" id="reviews">
  <div class="mb-8 max-w-3xl">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{copy.title}</h2>
    <p class="mt-4 text-slate-700">{copy.intro}</p>
  </div>

  <div class="grid auto-rows-[10.5rem] grid-cols-2 gap-3 sm:auto-rows-[11rem] sm:gap-4 md:grid-cols-6 md:auto-rows-[12rem]">
    {
      reviewMosaicItems.map((item, index) => {
        const desktopSpan = item.featured ? 'md:col-span-3 md:row-span-2' : 'md:col-span-2';

        if (item.type === 'photo') {
          return (
            <button
              type="button"
              class={`group relative overflow-hidden rounded-[1.35rem] border border-white/70 bg-alhambra-night text-left shadow-warm transition hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-alhambra-clay focus:ring-offset-2 sm:rounded-[1.75rem] ${desktopSpan}`}
              data-review-open
              data-review-id={item.id}
              aria-label={`${copy.openPhoto}: ${item.caption[locale]}`}
            >
              <img src={item.image} alt={item.alt[locale]} class="h-full w-full object-cover opacity-95 transition duration-500 group-hover:scale-105" loading="lazy" />
              <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-alhambra-night/90 to-transparent p-3 text-white sm:p-4">
                <span class="inline-flex items-center gap-2 text-[0.68rem] font-bold uppercase tracking-[0.18em] text-alhambra-sand sm:text-xs sm:tracking-[0.22em]">
                  <Camera class="h-4 w-4" aria-hidden="true" />
                  {copy.openPhoto}
                </span>
                <span class="mt-2 hidden text-sm leading-6 text-white/85 md:block">{item.caption[locale]}</span>
              </span>
            </button>
          );
        }

        const tone = index % 2 === 0 ? 'bg-white/85' : 'bg-alhambra-sand/90';

        return (
          <button
            type="button"
            class={`card group flex min-h-0 flex-col justify-between p-3 text-left transition hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-alhambra-clay focus:ring-offset-2 sm:p-5 ${desktopSpan} ${tone}`}
            data-review-open
            data-review-id={item.id}
            aria-label={`${copy.openReview}: ${item.traveler}`}
          >
            <span>
              <Quote class="h-6 w-6 text-alhambra-clay" aria-hidden="true" />
              <span class="mt-2 block overflow-hidden text-sm font-semibold leading-6 text-alhambra-night line-clamp-4 sm:mt-3 sm:text-base md:text-lg md:leading-7">
                {item.excerpt[locale]}
              </span>
            </span>
            <span class="mt-2 block text-[0.65rem] font-bold uppercase tracking-[0.14em] text-alhambra-clay sm:mt-3 sm:text-xs sm:tracking-[0.18em]">
              {item.traveler} · {item.origin[locale]}
            </span>
          </button>
        );
      })
    }
  </div>

  <dialog
    id={dialogId}
    class="max-h-[calc(100dvh-2rem)] w-[calc(100vw-2rem)] overflow-y-auto rounded-[1.5rem] border border-white/70 bg-white/95 p-0 text-alhambra-night shadow-warm backdrop:bg-alhambra-night/70 backdrop:backdrop-blur-sm sm:w-[min(92vw,48rem)] sm:rounded-[2rem]"
    aria-labelledby={dialogTitleId}
    data-review-dialog
  >
    <div class="relative p-5 sm:p-7">
      <button
        type="button"
        class="absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-alhambra-night text-white transition hover:bg-alhambra-clay focus:outline-none focus:ring-2 focus:ring-alhambra-clay focus:ring-offset-2"
        data-review-close
        aria-label={copy.close}
      >
        <X class="h-5 w-5" aria-hidden="true" />
      </button>
      <div class="pr-12">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h3 id={dialogTitleId} class="mt-2 font-serif text-2xl font-bold text-alhambra-night sm:text-3xl" data-review-dialog-title></h3>
      </div>
      <div class="mt-6" data-review-dialog-body></div>
    </div>
  </dialog>
</section>

<script is:inline define:vars={{ popupItems }}>
  const dialog = document.querySelector('[data-review-dialog]');
  const title = dialog?.querySelector('[data-review-dialog-title]');
  const body = dialog?.querySelector('[data-review-dialog-body]');
  const closeButton = dialog?.querySelector('[data-review-close]');
  let lastOpener = null;

  function clearBody() {
    if (!body) return;
    while (body.firstChild) {
      body.removeChild(body.firstChild);
    }
  }

  function renderPhoto(item) {
    if (!title || !body) return;
    title.textContent = item.caption;

    const figure = document.createElement('figure');
    figure.className = 'space-y-4';

    const image = document.createElement('img');
    image.src = item.image;
    image.alt = item.alt;
    image.className = 'max-h-[62vh] w-full rounded-[1.25rem] object-contain sm:max-h-[70vh] sm:rounded-[1.5rem]';

    const caption = document.createElement('figcaption');
    caption.className = 'text-sm leading-7 text-slate-700';
    caption.textContent = item.caption;

    figure.append(image, caption);
    body.append(figure);
  }

  function renderReview(item) {
    if (!title || !body) return;
    title.textContent = item.traveler;

    const quote = document.createElement('blockquote');
    quote.className = 'font-serif text-xl font-bold leading-snug text-alhambra-night sm:text-3xl';
    quote.textContent = `"${item.text}"`;

    const meta = document.createElement('p');
    meta.className = 'mt-5 text-sm font-bold uppercase tracking-[0.18em] text-alhambra-clay';
    meta.textContent = `${item.traveler} · ${item.origin}`;

    const route = document.createElement('p');
    route.className = 'mt-2 text-sm leading-7 text-slate-700';
    route.textContent = item.route;

    body.append(quote, meta, route);
  }

  function openItem(id, opener) {
    if (!(dialog instanceof HTMLDialogElement)) return;
    const item = popupItems.find((candidate) => candidate.id === id);
    if (!item) return;

    lastOpener = opener;
    clearBody();

    if (item.type === 'photo') {
      renderPhoto(item);
    } else {
      renderReview(item);
    }

    dialog.showModal();
    closeButton?.focus();
  }

  document.querySelectorAll(`[data-review-id]`).forEach((button) => {
    button.addEventListener('click', () => {
      openItem(button.getAttribute('data-review-id'), button);
    });
  });

  closeButton?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) {
      dialog.close();
    }
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) {
      dialog.close();
    }
  });

  dialog?.addEventListener('close', () => {
    if (lastOpener instanceof HTMLElement) {
      lastOpener.focus();
    }
  });
</script>
