---
const destination = '/es/';
const canonicalUrl = new URL(destination, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>Redirigiendo a Elyara</title>
    <script is:inline>
      window.location.replace('/es/');
    </script>
  </head>
  <body>
    <main>
      <p>Redirigiendo a <a href={destination}>la pagina principal en espanol</a>.</p>
    </main>
  </body>
</html>
