---
import { ArrowLeft, CalendarDays, CircleCheck, Compass, Mail, Sparkles } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getLocaleConfig,
  getTailorMadeContent,
  getTailorMadePath,
  getTailorMadeEmailUrl,
  locales,
  type Locale,
} from '@/lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => {
    const content = getTailorMadeContent(locale);

    return {
      params: { locale, customSlug: content.routeSlug },
      props: { locale },
    };
  });
}

const { locale } = Astro.props as { locale: Locale };
const copy = getLocaleConfig(locale);
const content = getTailorMadeContent(locale);
const emailUrl = getTailorMadeEmailUrl();
const alternates = locales.map((item) => ({ locale: item, path: getTailorMadePath(item) }));
---

<BaseLayout
  title={content.pageTitle}
  description={content.metaDescription}
  locale={locale}
  canonicalPath={getTailorMadePath(locale)}
  image="/images/mapa.png"
  alternates={alternates}
>
  <article class="section-shell py-8 sm:py-12 lg:py-20">
    <a href={`/${locale}/#tailor-made`} class="inline-flex items-center gap-2 text-sm font-bold text-alhambra-clay hover:text-alhambra-night">
      <ArrowLeft class="h-4 w-4" aria-hidden="true" />
      {copy.navTailorMade}
    </a>

    <section class="mt-7 grid gap-8 sm:mt-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1 class="mt-4 max-w-4xl font-serif text-4xl font-bold leading-tight text-alhambra-night sm:text-5xl lg:text-6xl">{content.title}</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700 sm:mt-6 sm:text-lg sm:leading-8">{content.intro}</p>
        <div class="mt-7 grid gap-3 sm:mt-8 sm:flex sm:flex-wrap">
          <a class="btn-primary w-full sm:w-auto" href={emailUrl}>
            <Mail class="h-4 w-4" aria-hidden="true" />
            {content.cta}
          </a>
          <a class="btn-secondary w-full sm:w-auto" href="#how-it-works">{content.secondaryCta}</a>
        </div>
      </div>
      <div class="card overflow-hidden p-3 sm:p-4">
        <img src="/images/mapa.png" alt={content.imageAlt} class="h-64 w-full rounded-[1.25rem] object-cover sm:h-[28rem] sm:rounded-[1.5rem]" />
      </div>
    </section>

    <section class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-2">
      <div class="card p-5 sm:p-7">
        <Compass class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
        <h2 class="mt-5 font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{content.consultationTitle}</h2>
        <p class="mt-4 leading-8 text-slate-700">{content.consultationText}</p>
      </div>
      <div class="card p-5 sm:p-7">
        <Sparkles class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
        <h2 class="mt-5 font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{content.routeTitle}</h2>
        <p class="mt-4 leading-8 text-slate-700">{content.routeText}</p>
      </div>
    </section>

    <section class="mt-10 grid gap-6 sm:mt-12 sm:gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start" id="how-it-works">
      <div class="card p-5 sm:p-7">
        <CalendarDays class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
        <h2 class="mt-5 font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{content.processTitle}</h2>
        <ol class="mt-6 grid gap-4">
          {
            content.process.map((item, index) => (
              <li class="flex gap-4 text-sm leading-7 text-slate-700">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-alhambra-clay text-xs font-bold text-white">{index + 1}</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="card p-5 sm:p-7">
        <h2 class="font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{content.inspirationTitle}</h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            content.inspiration.map((item) => (
              <div class="flex items-center gap-3 rounded-2xl bg-alhambra-sand/60 p-4 text-sm font-bold text-alhambra-night">
                <CircleCheck class="h-5 w-5 shrink-0 text-alhambra-clay" aria-hidden="true" />
                <span>{item}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mt-10 card grid gap-6 p-5 sm:mt-12 sm:gap-8 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="eyebrow">{content.detailsTitle}</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            content.details.map((item) => (
              <li class="flex items-center gap-3 text-sm font-bold text-slate-700">
                <CircleCheck class="h-5 w-5 shrink-0 text-alhambra-clay" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <a class="btn-primary w-full sm:w-auto" href={emailUrl}>
        <Mail class="h-4 w-4" aria-hidden="true" />
        {content.cta}
      </a>
    </section>
  </article>
</BaseLayout>
