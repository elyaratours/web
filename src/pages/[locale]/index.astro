---
import { ArrowRight, Mail, MapPinned, MessageCircle } from '@lucide/astro';
import ReservationCalendar from '@/components/ReservationCalendar.astro';
import TailorMadeHomeSection from '@/components/TailorMadeHomeSection.astro';
import TourCard from '@/components/TourCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEmailReservationUrl, getLocaleConfig, getWhatsAppReservationUrl, locales, type Locale } from '@/lib/i18n';
import { createItemListJsonLd, productionSiteUrl } from '@/lib/seo';
import { getSeoLandingPath, getSeoLandingsByKeys } from '@/lib/seo-landings';
import { getPublishedKidsTours, getPublishedTours, getTourPath } from '@/lib/tours';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getLocaleConfig(locale);
const tours = await getPublishedTours(locale);
const kidsTours = await getPublishedKidsTours(locale);
const homeCardTours = tours.filter((tour) => tour.data.translationKey !== 'cathedral-royal-chapel');
const planningLandings = await getSeoLandingsByKeys(locale, ['guided-visits-granada', 'private-guide-granada', 'private-alhambra-tour', 'albaicin-guided-walk', 'free-tour-granada']);
const alternates = locales.map((item) => ({ locale: item, path: `/${item}/` }));
const site = Astro.site ?? new URL(productionSiteUrl);
const listedTours = [...tours, ...kidsTours];
const visibleHomeTours = [...homeCardTours, ...kidsTours];
const planningCopy = locale === 'es'
  ? {
      eyebrow: 'Elige mejor tu visita',
      title: 'Rutas guiadas, guia privada y visitas culturales en Granada',
      text: 'Si aun no sabes que ruta encaja con tu viaje, estas guias te ayudan a comparar opciones antes de escribir por WhatsApp o email.',
    }
  : {
      eyebrow: 'Choose your visit well',
      title: 'Walking tours, private guide and cultural visits in Granada',
      text: 'If you are not sure which route fits your trip, these guides help you compare options before writing by WhatsApp or email.',
    };
const jsonLd = [
  createItemListJsonLd(
    copy.allTours,
    visibleHomeTours.map((tour) => ({ name: tour.data.title, path: getTourPath(tour) })),
    site,
  ),
  createItemListJsonLd(
    planningCopy.title,
    planningLandings.map((landing) => ({ name: landing.data.title, path: getSeoLandingPath(landing) })),
    site,
  ),
];
---

<BaseLayout title={copy.homeSeoTitle} description={copy.metaHome} locale={locale} canonicalPath={`/${locale}/`} image="/images/alhambra-clouds.jpeg" imageAlt={copy.heroImageAlt} alternates={alternates} jsonLd={jsonLd}>
  <section class="section-shell grid gap-8 py-10 sm:py-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-24">
    <div>
      <p class="eyebrow">{copy.heroEyebrow}</p>
      <h1 class="mt-4 max-w-4xl font-serif text-4xl font-bold leading-[0.98] tracking-tight text-alhambra-night sm:mt-5 sm:text-6xl lg:text-7xl">
        {copy.heroTitle}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700 sm:mt-6 sm:text-lg sm:leading-8">{copy.heroText}</p>
      <div class="mt-7 grid gap-3 sm:mt-8 sm:flex sm:flex-wrap sm:items-center">
        <a class="btn-primary w-full sm:w-auto" href="#tours">
          {copy.allTours}
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
        <a class="btn-secondary w-full sm:w-auto" href={getWhatsAppReservationUrl(locale)} target="_blank" rel="noreferrer">
          <MessageCircle class="h-4 w-4" aria-hidden="true" />
          {copy.reserveWhatsapp}
        </a>
        <a class="btn-secondary w-full sm:w-auto" href={getEmailReservationUrl()}>
          <Mail class="h-4 w-4" aria-hidden="true" />
          {copy.reserveEmail}
        </a>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
      <div class="card overflow-hidden p-3 sm:p-4">
        <img src="/images/alhambra-clouds.jpeg" alt={copy.heroImageAlt} width="1200" height="800" decoding="async" fetchpriority="high" class="h-56 w-full rounded-[1.25rem] object-cover sm:h-72 sm:rounded-[1.5rem]" />
      </div>
      <div class="card grid gap-4 p-5 sm:content-center sm:p-6">
        <div class="flex items-start gap-4">
          <span class="rounded-2xl bg-alhambra-tile/10 p-3 text-alhambra-tile"><MapPinned class="h-6 w-6" aria-hidden="true" /></span>
          <div>
            <h2 class="font-serif text-2xl font-bold text-alhambra-night">Granada, paso a paso</h2>
            <p class="mt-2 text-sm leading-7 text-slate-700">{copy.catalogIntro}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell py-8 sm:py-12" id="tours">
    <div class="mb-8 max-w-3xl">
      <p class="eyebrow">{copy.featuredTours}</p>
      <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{copy.allTours}</h2>
      <p class="mt-4 text-slate-700">{copy.catalogIntro}</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {homeCardTours.map((tour) => <TourCard tour={tour} showReservationCta />)}
    </div>
    {
      kidsTours.length > 0 && (
        <section class="mt-10 sm:mt-12" aria-labelledby="kids-tours-title">
          <div class="mb-8 max-w-3xl">
            <p class="eyebrow">{copy.allTours}</p>
            <h2 id="kids-tours-title" class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{copy.kidsToursTitle}</h2>
            <p class="mt-4 text-slate-700">{copy.kidsToursIntro}</p>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {kidsTours.map((tour) => <TourCard tour={tour} showReservationCta />)}
          </div>
        </section>
      )
    }
  </section>

  {planningLandings.length > 0 && (
    <section class="section-shell py-8 sm:py-12" aria-labelledby="planning-links-title">
      <div class="card p-5 sm:p-8">
        <div class="max-w-3xl">
          <p class="eyebrow">{planningCopy.eyebrow}</p>
          <h2 id="planning-links-title" class="mt-3 font-serif text-3xl font-bold text-alhambra-night sm:text-4xl">{planningCopy.title}</h2>
          <p class="mt-4 leading-8 text-slate-700">{planningCopy.text}</p>
        </div>
        <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {planningLandings.map((landing) => (
            <a class="rounded-2xl border border-alhambra-clay/15 bg-white/70 p-4 text-sm font-bold text-alhambra-night transition hover:-translate-y-0.5 hover:border-alhambra-clay hover:text-alhambra-clay" href={getSeoLandingPath(landing)}>
              {landing.data.title}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <ReservationCalendar locale={locale} tours={listedTours} />

  <TailorMadeHomeSection locale={locale} />
</BaseLayout>
