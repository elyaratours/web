---
import { BookOpen, Feather } from '@lucide/astro';
import BlogCard from '@/components/BlogCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLocaleConfig, locales, type Locale } from '@/lib/i18n';
import { getPublishedBlogPosts } from '@/lib/blog';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getLocaleConfig(locale);
const posts = await getPublishedBlogPosts(locale);
const alternates = locales.map((item) => ({ locale: item, path: `/${item}/blog/` }));
---

<BaseLayout title={copy.blogTitle} description={copy.blogIntro} locale={locale} canonicalPath={`/${locale}/blog/`} alternates={alternates}>
  <section class="section-shell grid gap-10 py-16 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:py-24">
    <div>
      <p class="eyebrow">{copy.blogEyebrow}</p>
      <h1 class="mt-5 max-w-4xl font-serif text-5xl font-bold leading-tight tracking-tight text-alhambra-night sm:text-6xl">
        {copy.blogTitle}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700">{copy.blogIntro}</p>
    </div>
    <div class="card relative overflow-hidden p-6">
      <div class="absolute right-8 top-8 text-alhambra-clay/20">
        <Feather class="h-24 w-24" aria-hidden="true" />
      </div>
      <div class="relative max-w-xl">
        <BookOpen class="h-9 w-9 text-alhambra-clay" aria-hidden="true" />
        <p class="mt-6 font-serif text-3xl font-bold leading-tight text-alhambra-night">
          {locale === 'es'
            ? 'Un lugar para leyendas, paseos lentos, hallazgos pequenos y Granada viva.'
            : 'A place for legends, slow walks, small discoveries and living Granada.'}
        </p>
      </div>
    </div>
  </section>

  <section class="section-shell py-12">
    <div class="mb-8 max-w-3xl">
      <p class="eyebrow">{copy.allArticles}</p>
      <h2 class="mt-3 font-serif text-4xl font-bold text-alhambra-night">{copy.blogEyebrow}</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>
</BaseLayout>
