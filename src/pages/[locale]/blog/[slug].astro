---
import { ArrowLeft, CalendarDays, MessageCircle } from '@lucide/astro';
import { render } from 'astro:content';
import TourCard from '@/components/TourCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBlogAlternates, getBlogPostPath, getPublishedBlogPosts, getRelatedToursForPost, type BlogEntry } from '@/lib/blog';
import { getBlogCategoryLabel, getLocaleConfig } from '@/lib/i18n';
import { createArticleJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();

  return posts.map((post) => ({
    params: { locale: post.data.locale, slug: post.data.postSlug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogEntry };
const copy = getLocaleConfig(post.data.locale);
const { Content } = await render(post);
const site = Astro.site ?? new URL('https://web-elyara.example');
const alternates = await getBlogAlternates(post);
const relatedTours = await getRelatedToursForPost(post);
const jsonLd = createArticleJsonLd(post, site);
const date = new Intl.DateTimeFormat(copy.htmlLang, { dateStyle: 'long' }).format(post.data.publishedDate);
---

<BaseLayout
  title={post.data.title}
  description={post.data.seoDescription}
  locale={post.data.locale}
  canonicalPath={getBlogPostPath(post)}
  image={post.data.image}
  alternates={alternates}
  jsonLd={jsonLd}
  ogType="article"
>
  <article class="section-shell py-12 lg:py-20">
    <a href={`/${post.data.locale}/blog/`} class="inline-flex items-center gap-2 text-sm font-bold text-alhambra-clay hover:text-alhambra-night">
      <ArrowLeft class="h-4 w-4" aria-hidden="true" />
      {copy.backToBlog}
    </a>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
      <div>
        <p class="eyebrow">{getBlogCategoryLabel(post.data.locale, post.data.category)}</p>
        <h1 class="mt-4 font-serif text-5xl font-bold leading-tight text-alhambra-night sm:text-6xl">{post.data.title}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700">{post.data.excerpt}</p>
        <p class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-slate-700">
          <CalendarDays class="h-4 w-4 text-alhambra-clay" aria-hidden="true" />
          {copy.publishedOn}: {date}
        </p>
      </div>
      {post.data.image && (
        <div class="card overflow-hidden p-4">
          <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} class="h-[28rem] w-full rounded-[1.5rem] object-cover" />
        </div>
      )}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
      <div class="card p-8">
        <div class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:text-alhambra-night prose-a:text-alhambra-clay">
          <Content />
        </div>
      </div>
      <aside class="card sticky top-28 p-6">
        <p class="eyebrow">{copy.blogEyebrow}</p>
        <h2 class="mt-3 font-serif text-3xl font-bold text-alhambra-night">{copy.relatedToursTitle}</h2>
        <p class="mt-4 text-sm leading-7 text-slate-700">{copy.relatedToursText}</p>
        <a class="btn-primary mt-6 w-full" href="https://wa.me/34600000000" target="_blank" rel="noreferrer">
          <MessageCircle class="h-4 w-4" aria-hidden="true" />
          {copy.reserve}
        </a>
      </aside>
    </div>

    {relatedTours.length > 0 && (
      <section class="mt-12">
        <div class="mb-8 max-w-3xl">
          <p class="eyebrow">{copy.relatedToursTitle}</p>
          <h2 class="mt-3 font-serif text-4xl font-bold text-alhambra-night">{copy.allTours}</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {relatedTours.map((tour) => <TourCard tour={tour} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
