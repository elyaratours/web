---
import { ArrowLeft, CircleCheck, Clock, Languages, Mail, MapPinned, MessageCircle, Sparkles, Ticket } from '@lucide/astro';
import { getCollection, render } from 'astro:content';
import FaqSection from '@/components/FaqSection.astro';
import ReservationCalendar from '@/components/ReservationCalendar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBlogPostPath, getPublishedBlogPosts } from '@/lib/blog';
import { contactEmail, getContactPath, getDayTripsContent, getDayTripsPath, getDayTripWhatsAppUrl, getLocaleConfig, getPrivateTourReservationEmailUrl, getPrivateTourWhatsAppReservationUrl, getTailorMadePath, whatsappDisplayNumber, type Locale } from '@/lib/i18n';
import { createBreadcrumbJsonLd, createFaqJsonLd, createTourJsonLd, productionSiteUrl } from '@/lib/seo';
import { getSeoLandingPath, getSeoLandingsByKeys } from '@/lib/seo-landings';
import { getPublishedTourEntries, getPublishedTours, getTourPath, type TourEntry } from '@/lib/tours';

export async function getStaticPaths() {
  const tours = await getPublishedTourEntries();

  return tours.map((tour) => ({
    params: { locale: tour.data.locale, slug: tour.data.routeSlug },
    props: { tour },
  }));
}

const { tour } = Astro.props as { tour: TourEntry };
const copy = getLocaleConfig(tour.data.locale);
const isDayTrip = tour.data.category === 'day-trip';
const dayTripCopy = getDayTripsContent(tour.data.locale);
const { Content } = await render(tour);
const site = Astro.site ?? new URL(productionSiteUrl);
const relatedLocales = await getCollection('tours', ({ data }) => {
  return data.published !== false && data.translationKey === tour.data.translationKey;
});
const alternates = relatedLocales.map((item) => ({ locale: item.data.locale as Locale, path: getTourPath(item) }));
const localizedTours = await getPublishedTours(tour.data.locale);
const relatedPosts = (await getPublishedBlogPosts(tour.data.locale)).filter((post) => post.data.relatedTours.includes(tour.data.translationKey));
const relatedSeoLandings = await getSeoLandingsByKeys(tour.data.locale, tour.data.relatedLandings);
const faqJsonLd = createFaqJsonLd(tour.data.faq);
const jsonLd = [
  createTourJsonLd(tour, site),
  createBreadcrumbJsonLd(
    [
      { name: tour.data.locale === 'es' ? 'Inicio' : 'Home', path: `/${tour.data.locale}/` },
      { name: isDayTrip ? dayTripCopy.pageTitle : copy.allTours, path: isDayTrip ? getDayTripsPath(tour.data.locale) : `/${tour.data.locale}/#tours` },
      { name: tour.data.title, path: getTourPath(tour) },
    ],
    site,
  ),
  faqJsonLd,
].filter((item) => item !== undefined);
const routePointLabels =
  tour.data.locale === 'es'
    ? { meetingPoint: 'Punto de encuentro', endingPoint: 'Final de la ruta' }
    : { meetingPoint: 'Meeting point', endingPoint: 'End of the route' };
const whatsappReservationUrl = isDayTrip
  ? getDayTripWhatsAppUrl(tour.data.locale, tour.data.title)
  : getPrivateTourWhatsAppReservationUrl(tour.data.locale, tour.data.title);
const backPath = isDayTrip ? getDayTripsPath(tour.data.locale) : `/${tour.data.locale}/#tours`;
const backLabel = isDayTrip ? dayTripCopy.pageTitle : copy.backToTours;
const primaryReservationLabel = isDayTrip ? dayTripCopy.primaryCta : copy.reservePrivateGroup;
const emailReservationUrl = isDayTrip ? tour.data.reservationUrl : getPrivateTourReservationEmailUrl(tour.data.locale, tour.data.title);
const emailReservationLabel = isDayTrip ? dayTripCopy.emailCta : copy.reserveEmail;
const reservationIntro = isDayTrip ? dayTripCopy.requestText : copy.privateGroupText;
---

<BaseLayout
  title={tour.data.title}
  description={tour.data.seoDescription}
  locale={tour.data.locale}
  canonicalPath={getTourPath(tour)}
  image={tour.data.image}
  imageAlt={tour.data.imageAlt}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article class="section-shell py-8 sm:py-12 lg:py-20">
    <a href={backPath} class="inline-flex items-center gap-2 text-sm font-bold text-alhambra-clay hover:text-alhambra-night">
      <ArrowLeft class="h-4 w-4" aria-hidden="true" />
      {backLabel}
    </a>

    <div class="mt-7 grid gap-8 sm:mt-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div>
        <p class="eyebrow">{isDayTrip ? dayTripCopy.detailEyebrow : 'Granada tour'}</p>
        <h1 class="mt-4 font-serif text-4xl font-bold leading-tight text-alhambra-night sm:text-5xl lg:text-6xl">{tour.data.title}</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700 sm:text-lg sm:leading-8">{tour.data.seoDescription}</p>
        <div class="mt-7 grid gap-3 text-sm text-slate-700 sm:mt-8 sm:grid-cols-3">
          <div class="card flex items-center gap-3 p-4">
            <Clock class="h-5 w-5 text-alhambra-clay" aria-hidden="true" />
            <div>
              <p class="font-bold text-alhambra-night">{copy.duration}</p>
              <p>{tour.data.duration}</p>
            </div>
          </div>
          <div class="card flex items-center gap-3 p-4">
            <Ticket class="h-5 w-5 text-alhambra-clay" aria-hidden="true" />
            <div>
              <p class="font-bold text-alhambra-night">{copy.price}</p>
              <p>{tour.data.price}</p>
            </div>
          </div>
          <div class="card flex items-center gap-3 p-4">
            <Languages class="h-5 w-5 text-alhambra-clay" aria-hidden="true" />
            <div>
              <p class="font-bold text-alhambra-night">{copy.languages}</p>
              <p>{tour.data.languages.join(' · ')}</p>
            </div>
          </div>
        </div>
      </div>
      <div class="card overflow-hidden p-3 sm:p-4">
        <img src={tour.data.image} alt={tour.data.imageAlt} width="1200" height="800" decoding="async" fetchpriority="high" class="h-64 w-full rounded-[1.25rem] object-cover sm:h-[28rem] sm:rounded-[1.5rem]" />
      </div>
    </div>

    <div class="mt-10 grid gap-6 sm:mt-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
      <div class="order-2 grid gap-4 lg:order-none">
        <div class="card p-5 sm:p-8">
          <div class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:text-alhambra-night prose-a:text-alhambra-clay">
            <Content />
          </div>
        </div>

        {isDayTrip && (
          <section class="card p-5 sm:p-8" aria-labelledby="day-trip-experience-title">
            <div class="max-w-3xl">
              <p class="eyebrow">Granada</p>
              <h2 id="day-trip-experience-title" class="mt-3 font-serif text-3xl font-bold text-alhambra-night">{dayTripCopy.chooseTitle}</h2>
              <p class="mt-4 leading-8 text-slate-700">{dayTripCopy.chooseText}</p>
            </div>
            <div class="mt-7 grid gap-5 md:grid-cols-2">
              {dayTripCopy.experienceOptions.map((option) => (
                <div class="rounded-[1.5rem] border border-alhambra-clay/10 bg-alhambra-sand/45 p-5">
                  <MapPinned class="h-7 w-7 text-alhambra-clay" aria-hidden="true" />
                  <h3 class="mt-4 font-serif text-2xl font-bold text-alhambra-night">{option.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-slate-700">{option.text}</p>
                  <ul class="mt-5 grid gap-3">
                    {option.details.map((detail) => (
                      <li class="flex items-center gap-3 text-sm font-bold text-slate-700">
                        <CircleCheck class="h-5 w-5 shrink-0 text-alhambra-clay" aria-hidden="true" />
                        <span>{detail}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )}

        {isDayTrip && (
          <section class="card p-5 sm:p-8" aria-labelledby="day-trip-complements-title">
            <div class="max-w-3xl">
              <Sparkles class="h-8 w-8 text-alhambra-clay" aria-hidden="true" />
              <h2 id="day-trip-complements-title" class="mt-4 font-serif text-3xl font-bold text-alhambra-night">{dayTripCopy.completeTitle}</h2>
              <p class="mt-4 leading-8 text-slate-700">{dayTripCopy.completeText}</p>
            </div>
            <div class="mt-7 grid gap-4 sm:grid-cols-3">
              {dayTripCopy.complements.map((complement) => (
                <div class="rounded-[1.25rem] bg-white/70 p-4">
                  <CircleCheck class="h-6 w-6 text-alhambra-clay" aria-hidden="true" />
                  <h3 class="mt-4 font-serif text-xl font-bold text-alhambra-night">{complement.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-slate-700">{complement.text}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {isDayTrip && (
          <div class="card p-5 text-sm leading-7 text-slate-700 sm:p-6">
            <p class="eyebrow">{dayTripCopy.requestTitle}</p>
            <h2 class="mt-3 font-serif text-2xl font-bold text-alhambra-night">{dayTripCopy.primaryCta}</h2>
            <p class="mt-4">{dayTripCopy.requestText}</p>
          </div>
        )}

        {tour.data.meetingPoint && tour.data.endingPoint && (
          <div class="card p-5 text-sm leading-7 text-slate-700 sm:p-6">
            <dl class="grid gap-3">
              <div>
                <dt class="inline font-bold text-alhambra-night">{routePointLabels.meetingPoint}:</dt>
                <dd class="inline"> {tour.data.meetingPoint}</dd>
              </div>
              <div>
                <dt class="inline font-bold text-alhambra-night">{routePointLabels.endingPoint}:</dt>
                <dd class="inline"> {tour.data.endingPoint}</dd>
              </div>
            </dl>
          </div>
        )}

        <FaqSection title={tour.data.locale === 'es' ? 'Preguntas frecuentes' : 'Frequently asked questions'} entries={tour.data.faq} />

        {!isDayTrip && (
          <section class="card p-5 text-sm leading-7 text-slate-700 sm:p-6" aria-labelledby="private-group-title">
            <h2 id="private-group-title" class="font-serif text-2xl font-bold text-alhambra-night">{copy.privateGroupTitle}</h2>
            <p class="mt-3">{copy.privateGroupText}</p>
          </section>
        )}

        <div class="card p-5 text-sm leading-7 text-slate-700 sm:p-6">
          <h2 class="font-serif text-2xl font-bold text-alhambra-night">{tour.data.locale === 'es' ? 'Sigue explorando Granada' : 'Keep exploring Granada'}</h2>
          <div class="mt-4 flex flex-wrap gap-3 font-bold">
            {isDayTrip && <a class="text-alhambra-clay hover:text-alhambra-night" href={getDayTripsPath(tour.data.locale)}>{copy.navDayTrips}</a>}
            <a class="text-alhambra-clay hover:text-alhambra-night" href={getTailorMadePath(tour.data.locale)}>{copy.navTailorMade}</a>
            <a class="text-alhambra-clay hover:text-alhambra-night" href={getContactPath(tour.data.locale)}>{copy.navContact}</a>
            {relatedSeoLandings.map((landing) => (
              <a class="text-alhambra-clay hover:text-alhambra-night" href={getSeoLandingPath(landing)}>{landing.data.title}</a>
            ))}
            {relatedPosts.slice(0, 2).map((post) => (
              <a class="text-alhambra-clay hover:text-alhambra-night" href={getBlogPostPath(post)}>{post.data.title}</a>
            ))}
          </div>
        </div>
      </div>
      <aside class="card order-1 p-5 sm:p-6 lg:sticky lg:top-28 lg:order-none">
        <p class="eyebrow">{isDayTrip ? dayTripCopy.requestTitle : copy.reserve}</p>
        <h2 class="mt-3 font-serif text-2xl font-bold text-alhambra-night sm:text-3xl">{tour.data.title}</h2>
        <p class="mt-4 text-sm leading-7 text-slate-700">{reservationIntro}</p>
        <a class="btn-primary mt-6 w-full" href={whatsappReservationUrl} target="_blank" rel="noreferrer">
          <MessageCircle class="h-4 w-4" aria-hidden="true" />
          {primaryReservationLabel}
        </a>
        <a class="btn-secondary mt-3 w-full" href={emailReservationUrl}>
          <Mail class="h-4 w-4" aria-hidden="true" />
          {emailReservationLabel}
        </a>
        <div class="mt-3 grid gap-1 text-center text-sm font-bold text-alhambra-clay">
          <p class="select-all">{whatsappDisplayNumber}</p>
          <p class="select-all">{contactEmail}</p>
        </div>
      </aside>
    </div>
  </article>

  <ReservationCalendar locale={tour.data.locale} tours={localizedTours} tour={tour} />
</BaseLayout>
